---
import BaseHead from '../../components/BaseHead.astro';
import { getLocalProjects } from '../../utils/localProjects';

export async function getStaticPaths() {
	const projects = getLocalProjects();
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const frameSrc = `/project-assets/${project.slug}/index.html`;
const waMessage = encodeURIComponent(`Halo, saya tertarik dengan project ${project.title}. Bisa dibantu diskusi lebih lanjut?`);
const waLink = `https://wa.me/628991245050?text=${waMessage}`;
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`${project.title} - Portofolio Fahri Pano`}
			description={`Preview proyek ${project.title}`}
		/>

        <style>
            .cta-text {
				font-size: 0.75rem;
				font-weight: 800;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: #14532d;
				text-shadow:
					0 0 0 rgba(34, 197, 94, 0),
					0 0 0 rgba(34, 197, 94, 0);
				animation: cta-glow 1.8s ease-in-out infinite;
            }

			@keyframes cta-glow {
				0%,
				100% {
					opacity: 0.88;
					text-shadow:
						0 0 0 rgba(34, 197, 94, 0),
						0 0 0 rgba(34, 197, 94, 0);
					transform: translateZ(0);
				}

				50% {
					opacity: 1;
					text-shadow:
						0 0 10px rgba(34, 197, 94, 0.35),
						0 0 22px rgba(74, 222, 128, 0.28);
					transform: translateZ(0) scale(1.02);
				}
			}

			@media (prefers-color-scheme: dark) {
				.cta-text {
					color: #bbf7d0;
				}
			}

			@media (min-width: 640px) {
				.cta-text {
					font-size: 0.875rem;
				}
			}
        </style>
	</head>
	<body class="overflow-hidden bg-white text-gray-900 dark:bg-gray-800 dark:text-white">
		<header class="fixed inset-x-0 top-0 z-50 h-12 border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-700 dark:bg-gray-900/85">
			<div class="mx-auto flex h-full w-full max-w-screen-2xl items-center justify-between gap-2 px-3 sm:px-4">
				<div class="min-w-0 text-xs font-bold uppercase tracking-wide text-primary-700 dark:text-primary-300 sm:text-sm">
					<img src="/logo.webp" alt="Fahri Pano Logo" class="inline h-5 w-5 mr-2" />
                    <span>{project.title}</span>
				</div>
				<div class="flex shrink-0 items-center gap-2">
					<a
						href="/portofolio"
						class="rounded-md border border-gray-300 px-2.5 py-1.5 text-[11px] font-semibold transition hover:border-primary-500 hover:text-primary-700 dark:border-gray-600 dark:hover:text-primary-300 sm:text-xs"
					>
						<svg class="inline w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4"/>
                        </svg>
                        Kembali
					</a>
					<a
						href={frameSrc}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-md bg-primary-700 px-2.5 py-1.5 text-[11px] font-semibold text-white transition hover:bg-primary-800 sm:text-xs"
					>
						<svg class="inline w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 4h4m0 0v4m0-4-5 5M8 20H4m0 0v-4m0 4 5-5"/>
                        </svg>
                        Buka
					</a>
				</div>
			</div>
		</header>

		<main class="h-screen w-screen pt-12 pb-12">
			<iframe
				title={`Preview ${project.title}`}
				src={frameSrc}
				class="h-full w-full border-0"
				loading="lazy"
			></iframe>
		</main>

		<footer class="fixed inset-x-0 bottom-0 z-50 h-12 border-t border-gray-200 bg-white/90 backdrop-blur dark:border-gray-700 dark:bg-gray-900/85">
			<div class="mx-auto flex h-full w-full max-w-screen-2xl items-center justify-between px-3 sm:px-4">
                <h2 class="inline mr-2 cta-text">
                    Mau buat landingpage seperti ini?
                </h2>
				<a
					href={waLink}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-md bg-green-600 px-3 py-2 text-[11px] font-semibold text-white transition hover:bg-green-700 sm:text-xs"
				>
					<svg class="h-3 w-3" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
						<path d="M20.52 3.48A11.79 11.79 0 0 0 12.1 0C5.56 0 .24 5.33.24 11.86c0 2.09.55 4.14 1.58 5.94L0 24l6.38-1.67a11.84 11.84 0 0 0 5.72 1.46h.01c6.53 0 11.85-5.33 11.86-11.86a11.8 11.8 0 0 0-3.45-8.45ZM12.1 21.78h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.78.99 1.01-3.68-.24-.38a9.88 9.88 0 0 1-1.51-5.26C2.17 6.43 6.67 1.93 12.1 1.93c2.65 0 5.14 1.03 7.01 2.9a9.83 9.83 0 0 1 2.9 7c0 5.43-4.49 9.94-9.91 9.95Zm5.44-7.43c-.3-.15-1.79-.89-2.07-.99-.27-.1-.47-.15-.67.15-.2.3-.77.99-.95 1.19-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.64-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.48-.5-.67-.5h-.57c-.2 0-.52.08-.79.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.09 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.79-.73 2.04-1.44.25-.71.25-1.31.17-1.44-.07-.12-.27-.2-.57-.35Z"/>
					</svg>
					WhatsApp
				</a>
			</div>
		</footer>
	</body>
</html>