---
import { type CollectionEntry, getCollection } from 'astro:content';
import { render } from 'astro:content';
import ProyekPost from '../../layouts/ProyekPost.astro';

export async function getStaticPaths() {
	const proyek = await getCollection('proyek');
	return proyek.map((item) => ({
		params: { slug: item.id },
		props: item,
	}));
}

type Props = CollectionEntry<'proyek'>;

const proyek = Astro.props;
const { Content } = await render(proyek);
---

<ProyekPost {...proyek.data}>
	<Content />

	<!-- Tombol kembali ke proyek -->
	<a
		href="/proyek/"
		class="inline-flex items-center text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300"
	>
		← Kembali ke Daftar Proyek
	</a>
</ProyekPost>
