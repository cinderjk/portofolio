---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const proyek = await getCollection('proyek');
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title="Daftar Proyek" description="Kumpulan proyek yang pernah saya kerjakan." />
	</head>
	<body class="bg-white text-gray-900 dark:bg-gray-800 dark:text-white">
		<Header />
		<main class="mx-auto max-w-6xl px-4 pb-16 pt-28">
			<section class="space-y-8">
				<div class="space-y-3 text-center">
					<h1 class="text-3xl font-extrabold text-primary-700 dark:text-primary-200 lg:text-4xl">Proyek</h1>
					<p class="mx-auto max-w-2xl text-base text-gray-600 dark:text-gray-300">
						Kumpulan proyek yang pernah saya kerjakan, lengkap dengan deskripsi singkat dan detail
						implementasi.
					</p>
				</div>
				<ul class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
					{
						proyek.map((item) => (
							<li class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900">
								<a href={`/proyek/${item.id}/`} class="block h-full">
									{item.data.heroImage && (
										<div class="overflow-hidden">
											<img
												width={720}
												height={360}
												src={item.data.heroImage}
												alt={item.data.title}
												class="w-full object-cover transition duration-500 group-hover:scale-105"
											/>
										</div>
									)}
									<div class="space-y-3 p-5">
										<p class="text-sm font-medium text-primary-700 dark:text-primary-300">{item.data.pubDate}</p>
										<h2 class="text-xl font-bold leading-tight text-gray-900 transition group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
											{item.data.title}
										</h2>
										<p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">{item.data.description}</p>
										<span class="inline-flex items-center text-sm font-semibold text-primary-700 group-hover:underline dark:text-primary-300">
											Lihat detail
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
