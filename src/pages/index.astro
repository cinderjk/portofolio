---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allProyek = await getCollection('proyek');
// shuffle and pick 3 random projects at build time
// const shuffled = allProyek.sort(() => Math.random() - 0.5).slice(0, 3);

const SITE_TITLE = 'Khoiri Nur Khaliq Pano - Fahri Pano';
const SITE_DESCRIPTION = 'Selamat datang di website portofolio saya';
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-white text-gray-900 dark:bg-gray-800 dark:text-white">
		<Header />

		<main id="home" class="mx-auto max-w-6xl px-4 pb-12 pt-28">
			<section class="grid items-center gap-10 lg:grid-cols-2">
				<div class="space-y-6">
					<img
						src="/decor-wave-line.png"
						alt="decor"
						class="pointer-events-none absolute left-2 top-24 -z-10 w-20 opacity-60 lg:left-14 lg:top-64 lg:w-32"
					/>
					<h1 class="text-3xl font-extrabold leading-tight text-primary-600 dark:text-primary-200 lg:text-5xl">
						Khoiri Nur Khaliq Pano
					</h1>
					<p class="text-lg text-gray-700 dark:text-gray-100">
						Saya adalah seorang developer yang berpengalaman sejak 2020 dalam membangun berbagai macam website dan aplikasi berbasis web. Keahlian saya mencakup WordPress, Laravel, Livewire, dan SvelteKit.
					</p>
					<p class="text-lg text-gray-700 dark:text-gray-100">
						Dalam perjalanan karier saya, saya telah mengerjakan proyek-proyek mulai dari portofolio pribadi menggunakan SvelteKit, hingga sistem CRM, ERP, dan E-Commerce untuk perusahaan distributor pakan ternak berbasis Laravel & Livewire, yang terintegrasi dengan Google AdSense dan Google Analytics.
					</p>
					<p class="text-lg text-gray-900 font-bold dark:text-gray-100">
						Jika anda ingin mulai bekerjasama, silahkan klik tombol dibawah
					</p>
					<div class="flex flex-wrap gap-4">
						<a
							href="/hubungi"
							class="rounded-lg bg-primary-700 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-primary-800"
						>
							Hubungi Saya
						</a>
						<a
							href="https://drive.google.com/file/d/10LRQ8iO4lLzDop-e7jvV7AbTgLG8zKJA/view?usp=sharing"
							target="_blank"
							rel="noreferrer"
							class="rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-800 transition hover:-translate-y-0.5 hover:border-primary-400 hover:text-primary-700 dark:border-gray-600 dark:bg-gray-900 dark:text-white"
						>
							Unduh CV
						</a>
					</div>
				</div>
				<div class="mx-auto order-first lg:order-none">
					<img
						src="/decor-dot-yellow.png"
						alt="decor"
						class="pointer-events-none absolute right-4 top-48 -z-10 hidden w-20 opacity-80 md:block lg:right-28 lg:top-24 lg:w-28"
					/>
					<img
						src="/fahripano.webp"
						alt="Fahri Pano"
						class="w-64 rounded-2xl shadow-2xl shadow-gray-400 dark:shadow-gray-900 lg:w-[420px]"
					/>
				</div>
			</section>

			<section id="skills" class="pt-16">
				<h2 class="py-6 text-center text-3xl font-extrabold">KEAHLIAN</h2>
				<div class="grid gap-5 lg:grid-cols-3">
					<article class="rounded-xl bg-primary-100 p-6 dark:bg-gray-900">
						<img src="/laravel.png" alt="Laravel" class="mb-4 h-14 w-14 object-contain" />
						<h3 class="mb-3 text-2xl font-bold">Laravel</h3>
						<p class="text-gray-700 dark:text-gray-100">
							Berpengalaman membangun aplikasi dari CRUD sederhana hingga e-commerce dan dashboard
							operasional perusahaan.
						</p>
					</article>
					<article class="rounded-xl bg-primary-100 p-6 dark:bg-gray-900">
						<img src="/svelte.png" alt="SvelteKit" class="mb-4 h-14 w-14 object-contain" />
						<h3 class="mb-3 text-2xl font-bold">SvelteKit</h3>
						<p class="text-gray-700 dark:text-gray-100">
							Membangun aplikasi web modern yang cepat, ringan, dan responsif untuk kebutuhan company
							profile hingga aplikasi kustom.
						</p>
					</article>
					<article class="rounded-xl bg-primary-100 p-6 dark:bg-gray-900">
						<img src="/wordpress.png" alt="WordPress" class="mb-4 h-14 w-14 object-contain" />
						<h3 class="mb-3 text-2xl font-bold">WordPress</h3>
						<p class="text-gray-700 dark:text-gray-100">
							Terbiasa membuat landing page dan website bisnis dengan fokus SEO, performa, dan
							emaintainability.
						</p>
					</article>
				</div>
			</section>

			<section class="pt-16">
				<h2 class="py-6 text-center text-3xl font-extrabold">JUGA FAMILIAR DENGAN</h2>
				<div class="grid grid-cols-3 gap-6 rounded-xl bg-gray-50 p-6 dark:bg-gray-800 lg:grid-cols-6">
					<img src="/livewire.png" alt="Livewire" class="mx-auto h-14 w-14 object-contain transition duration-300 hover:-translate-y-1" />
					<img src="/tailwind.png" alt="Tailwind" class="mx-auto h-14 w-14 object-contain transition duration-300 hover:-translate-y-1" />
					<img src="/flowbite.png" alt="Flowbite" class="mx-auto h-14 w-14 object-contain transition duration-300 hover:-translate-y-1" />
					<img src="/npm.png" alt="NPM" class="mx-auto h-14 w-14 object-contain transition duration-300 hover:-translate-y-1" />
					<img src="/firebase.png" alt="Firebase" class="mx-auto h-14 w-14 object-contain transition duration-300 hover:-translate-y-1" />
					<img src="/contentful.png" alt="Contentful" class="mx-auto h-14 w-14 object-contain transition duration-300 hover:-translate-y-1" />
				</div>
			</section>

			<section id="projects" class="pt-16">
				<h2 class="py-6 text-center text-3xl font-extrabold">PROJECT UNGGULAN</h2>
				<ul class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
					{
						allProyek.map((item) => (
							<li class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900">
								<a href={`/proyek/${item.id}/`} class="block h-full">
									{item.data.heroImage && (
										<div class="overflow-hidden">
											<img
												width={720}
												height={360}
												src={item.data.heroImage}
												alt={item.data.title}
												class="w-full object-cover transition duration-500 group-hover:scale-105"
											/>
										</div>
									)}
									<div class="space-y-3 p-5">
										<p class="text-sm font-medium text-primary-700 dark:text-primary-300">{item.data.pubDate}</p>
										<h2 class="text-xl font-bold leading-tight text-gray-900 transition group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
											{item.data.title}
										</h2>
										<p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">{item.data.description}</p>
										<span class="inline-flex items-center text-sm font-semibold text-primary-700 group-hover:underline dark:text-primary-300">
											Lihat detail
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
