---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-white text-gray-900 dark:bg-gray-800 dark:text-white">
		<Header />
		<main class="mx-auto max-w-6xl px-4 pb-16 pt-28">
			<section class="space-y-10">
				<div class="rounded-2xl border border-gray-200 bg-gradient-to-br from-primary-50 via-white to-primary-100 p-6 shadow-sm dark:border-gray-700 dark:from-gray-900 dark:via-gray-900 dark:to-gray-800 md:p-8">
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-primary-700 dark:text-primary-300">Blog</p>
					<h1 class="mt-3 text-3xl font-extrabold leading-tight text-gray-900 dark:text-white md:text-4xl">
						Catatan, Insight, dan Eksperimen Web
					</h1>
					<p class="mt-3 max-w-2xl text-sm text-gray-600 dark:text-gray-300 md:text-base">
						Kumpulan tulisan seputar pengembangan website, alur kerja, dan hal-hal praktis yang saya
						pelajari saat membangun project untuk klien maupun eksperimen pribadi.
					</p>
				</div>

				{
					posts.length === 0 ? (
						<div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-10 text-center text-gray-600 dark:border-gray-600 dark:bg-gray-900 dark:text-gray-300">
							Belum ada artikel yang dipublikasikan.
						</div>
					) : (
						<ul class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
							{posts.map((post) => (
								<li class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900">
									<a href={`/blog/${post.id}/`} class="block h-full">
										{post.data.heroImage && (
											<div class="overflow-hidden">
												<img
													width={720}
													height={360}
													src={post.data.heroImage}
													alt={post.data.title}
													class="h-44 w-full object-cover transition duration-500 group-hover:scale-105"
												/>
											</div>
										)}
										<div class="space-y-3 p-5">
											<p class="text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<h2 class="text-xl font-bold leading-tight text-gray-900 transition group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
												{post.data.title}
											</h2>
											<p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
												{post.data.description}
											</p>
											<span class="inline-flex items-center text-sm font-semibold text-primary-700 group-hover:underline dark:text-primary-300">
												Baca artikel
											</span>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
