---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title="Hubungi Saya" description="Mari terhubung untuk diskusi proyek, kolaborasi, atau konsultasi." />
	</head>
	<body class="bg-white text-gray-900 dark:bg-gray-800 dark:text-white">
		<Header />
		<main class="mx-auto max-w-6xl px-4 pb-16 pt-28">
			<section class="space-y-8">
				<div class="space-y-3 text-center">
					<h1 class="text-3xl font-extrabold text-primary-700 dark:text-primary-200 lg:text-4xl">Hubungi Saya</h1>
					<p class="mx-auto max-w-2xl text-base text-gray-600 dark:text-gray-300">
						Silakan pilih kanal komunikasi yang paling nyaman. Saya terbuka untuk diskusi
						proyek, kolaborasi, dan konsultasi pengembangan web.
					</p>
				</div>

				<ul class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
					<li class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900">
						<div class="space-y-3 p-5">
							<p class="text-sm font-medium text-primary-700 dark:text-primary-300">Email</p>
							<h2 class="text-xl font-bold leading-tight text-gray-900 transition group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
								Kirim pesan formal
							</h2>
							<p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
								Untuk kebutuhan bisnis, penawaran, atau dokumen kerja sama.
							</p>
							<a
								href="mailto:khoirinkp@gmail.com"
								class="inline-flex items-center text-sm font-semibold text-primary-700 group-hover:underline dark:text-primary-300"
							>
								khoirinkp@gmail.com
							</a>
						</div>
					</li>

					<li class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900">
						<div class="space-y-3 p-5">
							<p class="text-sm font-medium text-primary-700 dark:text-primary-300">WhatsApp</p>
							<h2 class="text-xl font-bold leading-tight text-gray-900 transition group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
								Diskusi cepat
							</h2>
							<p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
								Cocok untuk tanya jawab singkat, estimasi awal, atau jadwal meeting.
							</p>
							<a
								href="https://wa.me/628991245050"
								target="_blank"
								rel="noreferrer"
								class="inline-flex items-center text-sm font-semibold text-primary-700 group-hover:underline dark:text-primary-300"
							>
								+62 899 1245 050
							</a>
						</div>
					</li>

					<li class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-900 md:col-span-2 xl:col-span-1">
						<div class="space-y-3 p-5">
							<p class="text-sm font-medium text-primary-700 dark:text-primary-300">Lokasi</p>
							<h2 class="text-xl font-bold leading-tight text-gray-900 transition group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
								Ngasem, Kediri
							</h2>
							<p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
								Terbuka untuk kerja remote maupun kolaborasi on-site sesuai kebutuhan.
							</p>
							<span class="inline-flex items-center text-sm font-semibold text-primary-700 dark:text-primary-300">
								Indonesia
							</span>
						</div>
					</li>
				</ul>

				<div class="rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-sm dark:border-gray-700 dark:bg-gray-900">
					<h2 class="text-xl font-bold text-gray-900 dark:text-white">Siap memulai proyek baru?</h2>
					<p class="mx-auto mt-2 max-w-2xl text-sm text-gray-600 dark:text-gray-300">
						Ceritakan kebutuhanmu, target pengguna, dan timeline. Saya akan bantu menyiapkan solusi
						yang tepat dan terukur.
					</p>
					<div class="mt-5 flex flex-wrap items-center justify-center gap-3">
						<a
							href="mailto:khoirinkp@gmail.com?subject=Diskusi%20Proyek"
							class="rounded-full bg-primary-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-800"
						>
							Kirim Email
						</a>
						<a
							href="https://wa.me/628991245050"
							target="_blank"
							rel="noreferrer"
							class="rounded-full border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:border-primary-500 hover:text-primary-700 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200"
						>
							Chat WhatsApp
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
