---
import BaseHead from '../components/BaseHead.astro';
import FooterLinks from '../components/FooterLinks.astro';

const links = [
	{
		title: 'Websiteku',
		href: '/',
		iconLabel: 'FP',
		iconClass: 'fp',
	},
	{
		title: 'Proyek yang aku kerjakan',
		href: '/proyek',
		iconLabel: 'LV',
		iconClass: 'lv',
	},
	{
		title: 'Portofolio Wordpress',
		href: '/portofolio',
		iconLabel: 'WP',
		iconClass: 'wp',
	},
	{
		title: 'Jasa Pembuatan Web',
		href: '/jasa-pembuatan-website',
		iconLabel: 'WP',
		iconClass: 'wp',
	},
	{
		title: 'Tips dan Trik',
		href: '/blog',
		iconLabel: 'SV',
		iconClass: 'sv',
	},
];

const socials = [
	{ label: 'GitHub', href: 'https://github.com/cinderjk', key: 'gh' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/khoiri-nur-khaliq-pano-298926263/', key: 'in' },
	{ label: 'Facebook', href: 'https://www.facebook.com/fahripan0', key: 'fb' },
	{ label: 'Instagram', href: 'https://instagram.com/fahripano/', key: 'ig' },
	{ label: 'YouTube', href: 'https://www.youtube.com/@fahripano', key: 'yt' },
];
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title="Links - Fahri Pano"
			description="Kumpulan tautan penting Fahri Pano"
			image="/fahripano.webp"
		/>
	</head>
	<body class="min-h-screen bg-primary-200 text-gray-950 antialiased dark:bg-gray-950 dark:text-gray-100">
		<main class="mx-auto flex w-full max-w-xl flex-col gap-8 px-4 py-10 sm:py-14">
			<section class="flex flex-col items-center gap-4 text-center">
				<img src="/fahripano.webp" alt="Fahri Pano" class="h-24 w-24 rounded-full border-4 border-white object-cover shadow-lg ring-1 ring-gray-200 dark:border-primary-800 dark:ring-primary-800" />
				<h1 class="inline-flex items-center gap-2 text-2xl font-bold tracking-tight sm:text-3xl">Fahri Pano
					<img src="data:image/svg+xml;base64," alt="Verified profile" data-testid="verificationTick">
				</h1>
			</section>

			<section class="flex flex-col gap-3" aria-label="Daftar Tautan">
				{links.map((item) => (
					<a href={item.href} class="group flex items-center gap-3 rounded-2xl border border-gray-200 bg-white px-4 py-3 shadow-sm transition duration-200 hover:-trangray-y-0.5 hover:border-gray-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-primary-900 dark:bg-primary-950 dark:hover:border-primary-600">
						<span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-xs font-semibold tracking-wide text-gray-700 dark:bg-primary-800 dark:text-gray-200">{item.iconLabel}</span>
						<span class="flex-1 text-left text-sm font-medium text-gray-800 dark:text-gray-100 sm:text-base">{item.title}</span>
						<span class="flex items-center gap-1" aria-hidden="true"><span class="h-1.5 w-1.5 rounded-full bg-gray-400 transition-colors group-hover:bg-gray-600 dark:bg-gray-500 dark:group-hover:bg-gray-300"></span><span class="h-1.5 w-1.5 rounded-full bg-gray-400 transition-colors group-hover:bg-gray-600 dark:bg-gray-500 dark:group-hover:bg-gray-300"></span><span class="h-1.5 w-1.5 rounded-full bg-gray-400 transition-colors group-hover:bg-gray-600 dark:bg-gray-500 dark:group-hover:bg-gray-300"></span></span>
					</a>
				))}
			</section>

			<section class="flex flex-wrap items-center justify-center gap-2 pt-1" aria-label="Social Media">
				{socials.map((item) => (
					<a href={item.href} target="_blank" rel="noopener noreferrer" class="inline-flex h-10 min-w-10 items-center justify-center rounded-full border border-gray-300 bg-white px-3 text-xs font-semibold uppercase tracking-wider text-gray-700 transition hover:-trangray-y-0.5 hover:border-gray-400 hover:text-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-primary-700 dark:bg-primary-950 dark:text-gray-200 dark:hover:border-primary-400 dark:hover:text-white" aria-label={item.label}>
						{item.key.toUpperCase()}
					</a>
				))}
			</section>
		</main>
		<FooterLinks />
	</body>
</html>