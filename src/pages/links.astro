---
import BaseHead from '../components/BaseHead.astro';

const links = [
	{
		title: 'Websiteku',
		href: '/',
		iconLabel: 'FP',
		iconClass: 'fp',
	},
	{
		title: 'Proyek yang aku kerjakan',
		href: '/proyek',
		iconLabel: 'LV',
		iconClass: 'lv',
	},
	{
		title: 'Portofolio Wordpress',
		href: '/portofolio',
		iconLabel: 'WP',
		iconClass: 'wp',
	},
	{
		title: 'Jasa Pembuatan Web',
		href: '/jasa-pembuatan-website',
		iconLabel: 'WP',
		iconClass: 'wp',
	},
	{
		title: 'Buat Undangan Digital',
		href: '/hubungi?layanan=jasa-undangan-digital',
		iconLabel: 'WP',
		iconClass: 'wp',
	},
	{
		title: 'Tips dan Trik',
		href: '/blog',
		iconLabel: 'SV',
		iconClass: 'sv',
	},
];

const socials = [
	{ label: 'GitHub', href: 'https://github.com/cinderjk', key: 'gh' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/khoiri-nur-khaliq-pano-298926263/', key: 'in' },
	{ label: 'Facebook', href: 'https://www.facebook.com/fahripan0', key: 'fb' },
	{ label: 'Instagram', href: 'https://instagram.com/fahripano/', key: 'ig' },
	{ label: 'YouTube', href: 'https://www.youtube.com/@fahripano', key: 'yt' },
];
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title="Links - Fahri Pano"
			description="Kumpulan tautan penting Fahri Pano"
			image="/fahripano.webp"
		/>
		<style>
			.links-page {
				min-height: 100vh;
				background: radial-gradient(circle at top center, #1a2212 0%, #0a0f0c 62%);
				padding: 2rem 1rem;
			}

			.container {
				margin: 0 auto;
				max-width: 30rem;
			}

			.profile {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1.5rem;
			}

			.avatar {
				height: 6rem;
				width: 6rem;
				border-radius: 9999px;
				object-fit: cover;
				border: 3px solid #d9d536;
				box-shadow: 0 0 30px rgba(217, 213, 54, 0.22);
			}

			.name {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: #ffffff;
				font-size: 1.95rem;
				font-weight: 800;
				line-height: 1;
			}

			.badge {
				display: inline-flex;
				height: 1rem;
				width: 1rem;
				border-radius: 9999px;
				background: #21c8ff;
			}

			.link-list {
				display: grid;
				gap: 0.85rem;
			}

			.link-card {
				display: grid;
				grid-template-columns: 2.25rem 1fr 1rem;
				align-items: center;
				gap: 1rem;
				border-radius: 0.7rem;
				background: #6b5018;
				padding: 1rem 0.95rem;
				color: #fff;
				text-decoration: none;
				font-size: 1.12rem;
				font-weight: 700;
				transition: transform 140ms ease, filter 140ms ease;
			}

			.link-card:hover {
				transform: translateY(-1px);
				filter: brightness(1.07);
			}

			.left-icon {
				display: inline-flex;
				height: 2.25rem;
				width: 2.25rem;
				align-items: center;
				justify-content: center;
				border-radius: 9999px;
				font-size: 0.74rem;
				font-weight: 900;
				letter-spacing: 0.04em;
				background: rgba(255, 255, 255, 0.08);
			}

			.left-icon.fp { color: #e6eb80; }
			.left-icon.lv { color: #ff4028; }
			.left-icon.wp { color: #0db2ff; }
			.left-icon.sv { color: #ff5b1e; }

			.link-title {
				text-align: center;
			}

			.dots {
				height: 1rem;
				display: inline-flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.12rem;
			}

			.dots span {
				display: block;
				height: 0.14rem;
				width: 0.14rem;
				border-radius: 9999px;
				background: #fff;
			}

			.socials {
				margin-top: 2rem;
				display: flex;
				justify-content: center;
				gap: 0.9rem;
			}

			.social {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				height: 2.4rem;
				width: 2.4rem;
				border: 2px solid #d9d536;
				border-radius: 9999px;
				color: #d9d536;
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 800;
				transition: transform 140ms ease, background-color 140ms ease, color 140ms ease;
			}

			.social:hover {
				transform: translateY(-1px);
				background: #d9d536;
				color: #10140f;
			}

			@media (max-width: 640px) {
				.name { font-size: 1.9rem; }
				.link-card { font-size: 1rem; }
			}
		</style>
	</head>
	<body class="links-page">
		<main class="container">
			<section class="profile">
				<img src="/fahripano.webp" alt="Fahri Pano" class="avatar" />
				<h1 class="name">Fahri Pano 
					<img src="data:image/svg+xml;base64," alt="Verified profile" data-testid="verificationTick">
				</h1>
			</section>

			<section class="link-list" aria-label="Daftar Tautan">
				{links.map((item) => (
					<a href={item.href} class="link-card">
						<span class={`left-icon ${item.iconClass}`}>{item.iconLabel}</span>
						<span class="link-title">{item.title}</span>
						<span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
					</a>
				))}
			</section>

			<section class="socials" aria-label="Social Media">
				{socials.map((item) => (
					<a href={item.href} target="_blank" rel="noopener noreferrer" class="social" aria-label={item.label}>
						{item.key.toUpperCase()}
					</a>
				))}
			</section>
		</main>
	</body>
</html>