---
---

<header class="fixed top-0 z-30 w-full bg-white/95 shadow-sm backdrop-blur dark:bg-gray-800/95">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
		<a href="/" class="flex items-center gap-3 text-xl font-extrabold text-primary-700 dark:text-primary-200">
			<img src="/logo.webp" alt="Fahri Pano Logo" class="h-8 w-8 object-cover" />
			<span>Fahri Pano</span>
		</a>
		<button
			id="mobile-menu-toggle"
			type="button"
			class="inline-flex items-center justify-center rounded-lg border border-gray-300 p-2 text-gray-700 transition hover:bg-gray-100 md:hidden dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700"
			aria-label="Buka menu navigasi"
			aria-controls="mobile-nav"
			aria-expanded="false"
		>
			<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
		<div class="hidden items-center gap-6 text-sm font-semibold md:flex">
			<a href="/#home" class="transition hover:text-primary-600">Home</a>
			<div class="relative">
				<button
					id="desktop-layanan-toggle"
					type="button"
					class="inline-flex cursor-pointer items-center gap-1 transition hover:text-primary-600 focus:outline-none"
					aria-haspopup="true"
					aria-controls="desktop-layanan-menu"
					aria-expanded="false"
				>
					Layanan
					<svg
						id="desktop-layanan-icon"
						class="h-4 w-4 transition"
						viewBox="0 0 20 20"
						fill="currentColor"
						aria-hidden="true"
					>
						<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
					</svg>
				</button>
				<div
					id="desktop-layanan-menu"
					class="invisible absolute left-1/2 top-8 z-50 w-64 -translate-x-1/2 overflow-hidden rounded-xl border border-gray-200 bg-white text-gray-700 opacity-0 shadow-lg transition duration-200 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200"
				>
					<a href="/jasa-pembuatan-website" class="block border-b border-gray-100 px-4 py-3 transition hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800">
						Jasa Pembuatan Website
					</a>
					<a href="/hubungi?layanan=jasa-download-envato" class="block border-b border-gray-100 px-4 py-3 transition hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800">
						Jasa Download Envato
					</a>
					<a href="/hubungi?layanan=jasa-maintenance-wordpress" class="block border-b border-gray-100 px-4 py-3 transition hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800">
						Jasa Maintenance Wordpress
					</a>
					<a href="/hubungi?layanan=jasa-undangan-digital" class="block px-4 py-3 transition hover:bg-gray-100 dark:hover:bg-gray-800">
						Jasa Undangan Digital
					</a>
				</div>
			</div>
			<a href="/proyek" class="transition hover:text-primary-600">Proyek</a>
			<a href="/portofolio" class="transition hover:text-primary-600">Portofolio</a>
			<a href="/hubungi" class="transition hover:text-primary-600">Hubungi</a>
		</div>
	</nav>
	<div id="mobile-nav" class="hidden border-t border-gray-200 bg-white px-4 pb-4 pt-3 md:hidden dark:border-gray-700 dark:bg-gray-800">
		<div class="space-y-2 text-sm font-semibold text-gray-700 dark:text-gray-200">
			<a href="/#home" class="block rounded-lg px-3 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-700">Home</a>
			<a href="/proyek" class="block rounded-lg px-3 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-700">Proyek</a>
			<a href="/portofolio" class="block rounded-lg px-3 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-700">Portofolio</a>
			<a href="/hubungi" class="block rounded-lg px-3 py-2 transition hover:bg-gray-100 dark:hover:bg-gray-700">Hubungi</a>
			<div class="rounded-lg border border-gray-200 px-3 py-2 dark:border-gray-700">
				<button
					id="mobile-layanan-toggle"
					type="button"
					class="flex w-full items-center justify-between text-left text-xs font-bold uppercase tracking-wide text-primary-700 dark:text-primary-300"
					aria-controls="mobile-layanan-list"
					aria-expanded="false"
				>
					Layanan
					<svg class="h-4 w-4 transition" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
					</svg>
				</button>
				<div id="mobile-layanan-list" class="mt-2 hidden space-y-1">
					<a href="/jasa-pembuatan-website" class="block rounded-md px-2 py-1.5 text-sm transition hover:bg-gray-100 dark:hover:bg-gray-700">Jasa Pembuatan Website</a>
					<a href="/hubungi?layanan=jasa-download-envato" class="block rounded-md px-2 py-1.5 text-sm transition hover:bg-gray-100 dark:hover:bg-gray-700">Jasa Download Envato</a>
					<a href="/hubungi?layanan=jasa-maintenance-wordpress" class="block rounded-md px-2 py-1.5 text-sm transition hover:bg-gray-100 dark:hover:bg-gray-700">Jasa Maintenance Wordpress</a>
					<a href="/hubungi?layanan=jasa-undangan-digital" class="block rounded-md px-2 py-1.5 text-sm transition hover:bg-gray-100 dark:hover:bg-gray-700">Jasa Undangan Digital</a>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		const initMobileMenu = () => {
			const closeHandlerKey = '__desktopLayananCloseHandler';
			const desktopLayananToggle = document.getElementById('desktop-layanan-toggle');
			const desktopLayananMenu = document.getElementById('desktop-layanan-menu');
			const desktopLayananIcon = document.getElementById('desktop-layanan-icon');
			const toggle = document.getElementById('mobile-menu-toggle');
			const nav = document.getElementById('mobile-nav');
			const layananToggle = document.getElementById('mobile-layanan-toggle');
			const layananList = document.getElementById('mobile-layanan-list');
			if (
				!desktopLayananToggle ||
				!desktopLayananMenu ||
				!desktopLayananIcon ||
				!toggle ||
				!nav ||
				!layananToggle ||
				!layananList
			)
				return;

			const closeDesktopLayanan = () => {
				desktopLayananMenu.classList.add('invisible', 'opacity-0');
				desktopLayananToggle.setAttribute('aria-expanded', 'false');
				desktopLayananIcon.classList.remove('rotate-180');
			};

			const openDesktopLayanan = () => {
				desktopLayananMenu.classList.remove('invisible', 'opacity-0');
				desktopLayananToggle.setAttribute('aria-expanded', 'true');
				desktopLayananIcon.classList.add('rotate-180');
			};

			desktopLayananToggle.onclick = (event) => {
				event.stopPropagation();
				const isClosed = desktopLayananMenu.classList.contains('invisible');
				if (isClosed) {
					openDesktopLayanan();
				} else {
					closeDesktopLayanan();
				}
			};

			desktopLayananMenu.onclick = (event) => {
				event.stopPropagation();
			};

			const previousHandler = window[closeHandlerKey];
			if (previousHandler) {
				document.removeEventListener('click', previousHandler);
			}

			const closeOnDocumentClick = () => {
				closeDesktopLayanan();
			};

			window[closeHandlerKey] = closeOnDocumentClick;
			document.addEventListener('click', closeOnDocumentClick);

			toggle.onclick = () => {
				const isHidden = nav.classList.contains('hidden');
				nav.classList.toggle('hidden', !isHidden);
				toggle.setAttribute('aria-expanded', String(isHidden));

				if (!isHidden) {
					layananList.classList.add('hidden');
					layananToggle.setAttribute('aria-expanded', 'false');
				}
			};

			layananToggle.onclick = () => {
				const isHidden = layananList.classList.contains('hidden');
				layananList.classList.toggle('hidden', !isHidden);
				layananToggle.setAttribute('aria-expanded', String(isHidden));
			};
		};

		initMobileMenu();
		document.addEventListener('astro:page-load', initMobileMenu);
	</script>
</header>
