  0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
		</button>

<script is:inline>
	const bindThemeToggle = () => {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;


		btn.onclick = () => {
			document.documentElement.classList.toggle('dark');
			const activeTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
			localStorage.setItem(
				'color-theme',
				activeTheme
			);
			document.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme: activeTheme } }));
		};
	};

	bindThemeToggle();
	document.addEventListener('astro:page-load', bindThemeToggle);

	const bindScrollToTop = () => {
		const scrollToTopBtn = document.getElementById('scroll-to-top');
		if (scrollToTopBtn) {
			const toggleScrollButton = () => {
				const shouldShow = window.scrollY > 200;
				scrollToTopBtn.classList.toggle('invisible', !shouldShow);
				scrollToTopBtn.classList.toggle('opacity-0', !shouldShow);
				scrollToTopBtn.classList.toggle('pointer-events-none', !shouldShow);
			};

			toggleScrollButton();
			window.addEventListener('scroll', toggleScrollButton, { passive: true });

			scrollToTopBtn.onclick = () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			};
		}
	};

	bindScrollToTop();
	document.addEventListener('astro:page-load', bindScrollToTop);
	
</script>
