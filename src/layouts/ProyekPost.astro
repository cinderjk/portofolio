---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'proyek'>['data'];

const { title, description, pubDate, updatedDate, heroImage, demoUrl, repoUrl, stack = [] } = Astro.props;
---

<html lang="id">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-white text-gray-900 dark:bg-gray-800 dark:text-white">
		<Header />
		<main class="mx-auto max-w-5xl px-4 pb-16 pt-28">
			<article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-900">
				{heroImage && (
					<div class="overflow-hidden">
						<img width={1020} height={510} src={heroImage} alt={title} class="h-auto w-full object-cover" />
					</div>
				)}
				<div class="space-y-6 p-6 md:p-8">
					<div class="space-y-4 border-b border-gray-200 pb-6 dark:border-gray-700">
						<div class="flex flex-wrap items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
							<span class="rounded-full bg-primary-100 px-3 py-1 font-semibold text-primary-800 dark:bg-primary-900 dark:text-primary-200">
								Dipublikasikan: {pubDate}
							</span>
							{updatedDate && (
								<span class="rounded-full bg-gray-100 px-3 py-1 font-semibold text-gray-700 dark:bg-gray-800 dark:text-gray-200">
									Diperbarui: {updatedDate}
								</span>
							)}
						</div>
						<h1 class="text-3xl font-extrabold leading-tight text-primary-700 dark:text-primary-200 md:text-4xl">{title}</h1>
						<p class="text-base leading-relaxed text-gray-600 dark:text-gray-300">{description}</p>
						{stack.length > 0 && (
							<div class="flex flex-wrap gap-2">
								{stack.map((item) => (
									<span class="rounded-full border border-gray-300 px-3 py-1 text-sm font-medium text-gray-700 dark:border-gray-600 dark:text-gray-200">
										{item}
									</span>
								))}
							</div>
						)}
						{(demoUrl || repoUrl) && (
							<div class="flex flex-wrap gap-3 pt-1">
								{demoUrl && (
									<a
										href={demoUrl}
										target="_blank"
										rel="noreferrer"
										class="rounded-lg bg-primary-700 px-4 py-2 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-primary-800"
									>
										Lihat Demo
									</a>
								)}
								{repoUrl && (
									<a
										href={repoUrl}
										target="_blank"
										rel="noreferrer"
										class="rounded-lg border border-gray-300 bg-white px-4 py-2 font-semibold text-gray-800 transition hover:-translate-y-0.5 hover:border-primary-500 hover:text-primary-700 dark:border-gray-600 dark:bg-gray-900 dark:text-gray-100"
									>
										Lihat Repository
									</a>
								)}
							</div>
						)}
					</div>
					<div class="space-y-4 text-base leading-relaxed text-gray-700 dark:text-gray-200 [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-gray-900 dark:[&_h2]:text-white [&_h3]:mt-6 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-gray-900 dark:[&_h3]:text-white [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-2 [&_a]:font-semibold [&_a]:text-primary-700 hover:[&_a]:underline dark:[&_a]:text-primary-300">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
